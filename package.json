{
  "name": "hmv-global",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cms": "vite --mode cms",
    "build": "vite build",
    "build:cms": "vite build --mode cms --outDir dist-cms",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run build:cms && npx playwright test && npx playwright test -c playwright.cms.config.js",
    "test:e2e:fast": "npx playwright test",
    "test:e2e:cms": "npm run build:cms && npx playwright test -c playwright.cms.config.js",
    "test:visual": "npm run build && npx playwright test tests/visual.spec.js",
    "lint": "eslint . && node scripts/check-boundaries.js",
    "build:dev": "vite build --mode development",
    "next:dev": "next dev -p 4175",
    "next:build": "next build",
    "next:start": "next start -p 4175",
    "test:e2e:next": "npm run next:build && npx playwright test -c playwright.next.config.js",
    "test:e2e:next-cms": "npx playwright test -c playwright.next-cms.config.js && npx playwright test -c playwright.next-cms-stale.config.js"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flag-icons": "^7.5.0",
    "lucide-react": "^0.475.0",
    "next": "16.4.5",
    "radix-ui": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
